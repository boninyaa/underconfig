  {
    "id": "mobo",
    "category": "graphics",
    "label": "motion blur",
    "description": "adjust motion blur. lower settings consume less CPU/GPU power. also not amazing for your eyes.",
    "type": "sslider",
    "options": [
      "none",
      "low",
      "high"
